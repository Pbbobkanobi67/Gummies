# Blue Raffle Blockhash - Deployment Configuration
# Copy this file to .env and fill in your values

# Your BNB Testnet Private Key (DO NOT SHARE!)
PRIVATE_KEY=your_private_key_here

# BLUE Token Address on BNB Testnet
BLUE_TOKEN=0xf11Af396703E11D48780B5154E52Fd7b430C6C01

# Wallet Addresses (will use deployer address if not specified)
TREASURY_WALLET=0xYourTreasuryWalletHere
DEVELOPER_WALLET=0xYourDeveloperWalletHere

# BscScan API Key (for contract verification - optional)
BSCSCAN_API_KEY=your_bscscan_api_key_here
